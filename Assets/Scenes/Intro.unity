MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 365984054}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d684b72a54bee534198290ef4d4a326d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCutscene
  nextScene: level1
  nina: {fileID: 1787981094}
  granny: {fileID: 876184235}
  sketch: {fileID: 2120119219}
  door: {x: 2.5, y: 1.2, z: 2.2}
  bookTitle: "Chapter 0  \xB7  The Dream"
  seat: {x: 0.2, y: 0.49, z: 1.41}
  flipLying: 0
  bodyThickness: 0.09
  seatForward: -0.06
  story:
  - shot: 0
    speaker: 
    text: Every evening, Nina stretched out on the couch with a warm cup of matcha and her sketchbook.
  - shot: 2
    speaker: Nina
    text: Mmm... matcha and drawing. My favorite part of the day.
  - shot: 1
    speaker: 
    text: 'And every evening, she drew the same dream: a little restaurant of her very own.'
  - shot: 1
    speaker: Nina
    text: Warm lights, cozy tables, the best food in town... I'll call it "Nina's Kitchen".
  - shot: 3
    speaker: Grandma
    text: That's a lovely drawing, sweetheart. One day it will be real.
  - shot: 4
    speaker: Mom
    text: Ninaaa! Can you come help me cook dinner tonight?
  - shot: 2
    speaker: Nina
    text: Coming, Mom! ...Maybe today is where it all starts.
