  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 126046383}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d684b72a54bee534198290ef4d4a326d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroCutscene
  nextScene: level1
  nina: {fileID: 589079704}
  granny: {fileID: 1850186069}
  sketch: {fileID: 1545622291}
  door: {x: 2.5, y: 1.2, z: 2.2}
  lines:
  - shot: 0
    speaker: 
    text: Saturday evening. Nina's living room.
  - shot: 2
    speaker: Nina
    text: Mmm... coffee and drawing. My favorite part of the day.
  - shot: 1
    speaker: Nina
    text: Someday I'll open my own restaurant. Warm lights, cozy tables...
  - shot: 1
    speaker: Nina
    text: ...and the best food in town. I'll call it "Nina's Kitchen".
  - shot: 3
    speaker: Grandma
    text: That's a lovely drawing, sweetheart. You'll get there one day.
  - shot: 4
    speaker: Mom
    text: Ninaaa! Can you come help me cook dinner tonight?
  - shot: 2
    speaker: Nina
    text: Coming, Mom! ...Okay. Maybe today is where it all starts.
